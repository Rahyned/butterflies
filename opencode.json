{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "plan.md"],
  "lsp": {
    "rust-analyzer": {
      "command": ["C:\\Users\\Lau\\.vscode\\extensions\\rust-lang.rust-analyzer-0.3.2913-win32-x64\\server\\rust-analyzer.exe"],
      "extensions": ["rs"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": ["ts", "tsx", "js", "jsx", "mjs", "cjs", "mts", "cts"]
    }
  },
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "C:\\Users\\Lau\\Lau\\memory.jsonl"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
